# Copy to server/.env locally; production secrets belong in the host's secret settings.
OPENAI_API_KEY=
# Model with Responses API + Structured Outputs support, available in your OpenAI project.
OPENAI_MODEL=
# A separate random access code (at least 24 characters), NEVER the OpenAI key.
AI_CHAT_TOKEN=
AI_ALLOWED_ORIGINS=https://jtaeubrich.github.io,http://localhost:8787,http://127.0.0.1:8787
HOST=127.0.0.1
PORT=8787
# Optional for local testing: serve the editor on the same port.
SERVE_EDITOR=true
